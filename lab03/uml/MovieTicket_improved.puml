@startuml MovieTicket_improved

skinparam classAttributeIconSize 0
skinparam class {
    BackgroundColor White
    BorderColor #27744C
    HeaderBackgroundColor #27744C
    HeaderFontColor White
    FontSize 12
    AttributeFontSize 11
}

class MovieTicket {
  - m_hallNumber      : int
  - m_seatNumber      : int
  - m_price           : double
  - m_booked          : bool
  - m_durationMinutes : int

  + MovieTicket(hallNumber : int, seatNumber : int, price : double, booked : bool, durationMinutes : int)

  + getHallNumber()      const : int
  + getSeatNumber()      const : int
  + getPrice()           const : double
  + getBooked()          const : bool
  + getDurationMinutes() const : int

  + setPrice(value : double) : void

  + book()                                  : void
  + cancelBooking()                         : void
  + isPremium()              const          : bool
  + discountedPrice(percent : double) const : double
  + isLongMovie()            const          : bool
}

note right of MovieTicket
  Removed setters:
  - setHallNumber()     (identity field)
  - setSeatNumber()     (identity field)
  - setBooked()         (bypasses book/cancelBooking logic)
  - setDurationMinutes()(immutable after creation)
end note

@enduml
